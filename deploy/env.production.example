# Kelsey Environment Variables (Production)
# This file should be at /var/www/kelsey/.env and NOT committed to git.

# Server
NODE_ENV=production
PORT=3001
DB_PATH=/var/www/kelsey/server/kelsey.db

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME

# CORS (must match the domain)
CORS_ORIGIN=https://klc.lat,https://www.klc.lat

# Frontend socket URL (used by browser to connect to Socket.io)
VITE_SOCKET_URL=https://klc.lat
VITE_SIGNALING_SERVER_URL=https://klc.lat

# Gemini API (leave empty if not needed)
VITE_GEMINI_API_KEY=

# LiveKit (leave defaults if not using)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
